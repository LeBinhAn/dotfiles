{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "display": {
    "separator": " ",
  },
  "logo": {
    "type": "none",
  },
  "modules": [
    "break",
    {
      "type": "title",
      "color": {
        "user": "bright_magenta",
        "at": "bright_white",
        "host": "bright_blue",
      },
    },
    "break",
    {
      "type": "os",
      "key": "",
      "keyColor": "bright_yellow",
    },
    {
      "type": "cpu",
      "key": "",
      "keyColor": "bright_magenta",
    },
    {
      "type": "board",
      "key": "󰚗",
      "keyColor": "yellow",
    },
    {
      "type": "memory",
      "key": "",
      "keyColor": "bright_green",
      "format": "{used} / {total} ({percentage})",
    },
    {
      "type": "disk",
      "key": "",
      "keyColor": "bright_cyan",
    },
    "break",
    {
      "type": "colors",
      "symbol": "circle",
    },
  ],
}
