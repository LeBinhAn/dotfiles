[delta "catppuccin-frappe"]
    blame-palette = "#303446 #292c3c #232634 #414559 #51576d"
    commit-decoration-style = "box ul"
    dark = true
    file-decoration-style = "#c6d0f5 ul"
    file-style = "#c6d0f5"
    hunk-header-decoration-style = "box ul"
    hunk-header-file-style = "bold #c6d0f5"
    hunk-header-line-number-style = "bold #a5adce"
    hunk-header-style = "file line-number syntax"
    line-numbers = true
    line-numbers-left-style = "#737994"
    line-numbers-right-style = "#737994"
    line-numbers-zero-style = "#51576d"
    minus-emph-style = "bold syntax #563f46"
    minus-style = "syntax #41353f"
    plus-emph-style = "bold syntax #404f4a"
    plus-style = "syntax #343e44"
    syntax-theme = "Catppuccin Frappe"

