# Start by ignoring everything
*

# Then explicitly allow what you want tracked
!.gitignore
!.zshrc
!.bashrc
!.gitconfig
!.tmux.conf

# Config directories
!.config/
!.config/nvim/**
!.config/tmux/**

# Exclude plugin/cache directories within tracked configs
.config/nvim/plugin/
.config/nvim/.repro/
